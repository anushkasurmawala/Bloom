# Netlify: add these in Site configuration > Environment variables (Functions scope).
# Never commit the actual .env file or the encryption key.
SUPABASE_URL=https://hjqkwgxwlpdxaddgbmcx.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
# Exact stable HTTPS Netlify URL, no trailing slash. Set after creating the site.
APP_URL=https://your-site.netlify.app
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable; changing it prevents decrypting existing hosted journals.
BLOOM_DATA_KEY=your_64_character_hex_key
